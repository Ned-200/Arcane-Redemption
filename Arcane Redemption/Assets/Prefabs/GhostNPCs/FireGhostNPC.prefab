  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GhostNPC
  maxHealth: 100
  maxStamina: 100
  maxMana: 100
  staminaRegenRate: 20
  manaRegenRate: 10
  staminaRegenDelay: 1
  manaRegenDelay: 2
  weaponSlotTransform: {fileID: 0}
  footstepSounds: []
  lowHealthEffects: {fileID: 0}
  SpeakImagePrefab: {fileID: 5010717163584122740, guid: 5435685a6e1c9a34d9185f2794b50ad8, type: 3}
  FadeUI: {fileID: 0}
  cutsceneCamera:
  - {fileID: 2523529956305888260}
  cutsceneLine: 07000000
  endCutsceneLine: 0
  DialogueBox: {fileID: 0}
  textComponent: {fileID: 0}
  lines:
  - ...Where am I... <b><color=#8134ad>Maguso</color></b>?
  - ...Oh, I remember now...
  - Our leader <b><color=#541834>Skar</color></b>... He gave me control of the land's
    <b><color=#ff3300>fire</color></b>...
  - It.. <b><color=#541834>changed</color></b> me... and I think he knew it would...
  - ...He tricked us, made us into those <b><color=#541834>mindless beasts</color></b>
    to gaurd the elements...
  - ...But I see now that you have freed me... Thank you, old partner...
  - <b><color=#541834>Skar</color></b> will be a much greater threat than the monsters
    he made the rest of us into...
  - I wish you luck, may the Arcane grant you strength...
  hasSecondaryLines: 0
  secondaryLines: []
  textSpeed: 0.075
  skipSounds:
  - {fileID: 8300000, guid: edfa369940f7afc48a7026ba060c8217, type: 3}
  - {fileID: 8300000, guid: 76ff9621d3dcb984daca269fe0ab79b9, type: 3}
