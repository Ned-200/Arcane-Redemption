{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "1abc570fbd384bd385756058ce728383",
    "m_Title": "Method 1",
    "m_Content": "The first depth fade calculates the distance between the camera and teh water to create the deep vs shallow colour view. But this causes artifacting when you walk further away or move. ",
    "m_TextSize": 0,
    "m_Theme": 0,
