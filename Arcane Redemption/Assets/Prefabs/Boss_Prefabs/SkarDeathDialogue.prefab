  endCutsceneLine: 0
  DialogueBox: {fileID: 1729711562497775644}
  textComponent: {fileID: 0}
  lines:
  - NO! THIS CANNOT BE!
  - ALL THAT I'VE WORKED FOR, THE POWER I HARNESSED TO GET HERE...
  - You... You and I are not so different, Magsuo...
  - Gathering the Elemental Gems... It felt good, did it not? The power?
  - I can grant you all that and more... Let me share my powers with you...
  - Please, if you leave me here like this, I will not survive...
  - I am giving you a choice, my child.
  - Either join me, and I can make you a god!
  - ...Or leave now, and let those fools of that little town decide your fate.
  - What will it be?
  hasSecondaryLines: 0
  secondaryLines: []
  textSpeed: 0.015
  skipSounds:
  - {fileID: 8300000, guid: 57e00003ed1b7a14287b9a05ec13df50, type: 3}
