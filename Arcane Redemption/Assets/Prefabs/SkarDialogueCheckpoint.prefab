  m_Script: {fileID: 11500000, guid: 7b5b864c83a3f384db49fec6e84804d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SkarDialogue
  maxHealth: 100
  maxStamina: 100
  maxMana: 100
  staminaRegenRate: 20
  manaRegenRate: 10
  staminaRegenDelay: 1
  manaRegenDelay: 2
  weaponSlotTransform: {fileID: 0}
  footstepSounds: []
  lowHealthEffects: {fileID: 0}
  SpeakImagePrefab: {fileID: 0}
  FadeUI: {fileID: 0}
  cutsceneCamera: []
  cutsceneLine: 
  endCutsceneLine: 0
  DialogueBox: {fileID: 0}
  textComponent: {fileID: 0}
  lines:
  - ...I've been expecting you, Maguso.
  - It has been a while since we last spoke, hasn't it?
  - It's a shame to see what you've been reduced to, a lapdog for the Mayor and his
    little town...
  - Have you really come here to <b><color=#541834>defy</color></b> me?
  - I taught you everything you know about the Arcane...
  - Raised you as though you were my own son... And <b><color=#541834>this</color></b>
    is the thanks I get?
  - I let you get captured and jailed, you know... To keep you out of this...
  - I <b><color=#541834>NEED</color></b> this power, and I <b><color=#541834>needed</color></b>
    your friends to take it.
  - I wanted to leave you out of it, but here you are, crawling back like a roach...
  - You may have the elements, but I am <b><color=#541834>beyond</color></b> the
    natural order.
  - I hold the power of life at my fingertips... and soon I will have <b><color=#541834>yours</color></b>.
  hasSecondaryLines: 0
  secondaryLines: []
  textSpeed: 0.015
  skipSounds:
  - {fileID: 8300000, guid: 57e00003ed1b7a14287b9a05ec13df50, type: 3}
  - {fileID: 8300000, guid: cf010d3d95db40c4492a1f0a5ec704b5, type: 3}
